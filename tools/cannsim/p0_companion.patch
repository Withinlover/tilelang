+++ b/cosim/runtime.py
@@ -0,0 +1,38 @@
+"""Explicit off-only bridge to the pinned helper's original runtime API.
+
+The P0 pure-Cube companion does not contain, load, or certify a MIX scheduler
+repair. Keep this boundary explicit instead of importing unrelated local fixes.
+"""
+
+from utils.execution import record_environment as _record_environment
+
+
+def prepare_mix_scheduler_fix(cann_home, mode, blocks, expected_cores):
+    """Record the absence of a scheduler repair; reject unsupported modes."""
+    if mode != "off":
+        raise ValueError("P0 companion supports only mix_scheduler_fix='off'")
+    return {
+        "mode": "off",
+        "apply": False,
+        "reason": "P0 pure-Cube companion; no MIX scheduler repair included",
+        "blocks": blocks,
+        "mixed": any(core.startswith("AIV") for core in expected_cores),
+        "verification": {"status": "not_applied"},
+    }
+
+
+def _require_off(fix):
+    if not isinstance(fix, dict) or fix.get("mode") != "off" or fix.get("apply") is not False:
+        raise ValueError("P0 companion cannot apply or validate a MIX scheduler repair")
+
+
+def record_environment(cann_home, run_dir, mix_scheduler_fix):
+    """Use the pinned helper's ordinary simulator environment without a shim."""
+    _require_off(mix_scheduler_fix)
+    return _record_environment(cann_home, run_dir)
+
+
+def validate_mix_scheduler_fix(fix, run_dir, blocks):
+    """Only confirm that no repair was requested; never claim MIX validation."""
+    _require_off(fix)
+    return {"passed": True, "status": "not_applied", "report": None}
diff --git a/cosim/segments.py b/cosim/segments.py
new file mode 100644
index 0000000..35d1bee
--- /dev/null
+++ b/cosim/segments.py
@@ -0,0 +1,253 @@
+"""One fresh CANN process per fixed-size GEMM segment of a functional co-simulation.
+
+Communication and inter-rank ordering belong to the host-side protocol model.
+This adapter evaluates only a single 64x64 BF16 GEMM on the single-device CANN
+Simulator and preserves its ordinary accuracy and Core 0 trace checks.
+This companion supports only the explicit MIX scheduler fix mode "off".
+"""
+
+import copy
+import math
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from types import SimpleNamespace
+
+import numpy as np
+
+from cases.gemm import GemmCase
+from utils.accuracy import check_output, load_inputs
+from utils.environment import SOC_VERSION
+from utils.execution import build_runner, isolate_runner
+from utils.generate_report import export_traces
+from utils.io import sha256, write_json
+from cosim.runtime import prepare_mix_scheduler_fix, record_environment, validate_mix_scheduler_fix
+
+
+class SegmentExecutionError(RuntimeError):
+    """A segment failed; its diagnostics remain available in its manifest."""
+
+    def __init__(self, manifest):
+        self.manifest = manifest
+        self.manifest_path = Path(manifest["manifest_path"])
+        reasons = manifest.get("errors", [])
+        super().__init__(f"rank {manifest['rank']} segment {manifest['segment_id']} failed: {'; '.join(reasons)}; see {self.manifest_path}")
+
+
+class GemmSegmentExecutor:
+    """Build once, then run independent, bounded one-launch GEMM recordings.
+
+    ``execute`` accepts raw little-endian BF16 ``uint16`` arrays, both [64,64],
+    and returns the actual [64,64] FP32 simulator output. Every attempted launch
+    appends a final manifest to ``reports``, including unsuccessful recordings.
+    Segment IDs identify work in the protocol model and must be filesystem-safe.
+    The caller must serialize calls; concurrent simulator execution is not used.
+    """
+
+    def __init__(self, kernel, run_dir, cann_home, mix_scheduler_fix="off", rtol=1e-5, atol=1e-5, timeout_seconds=120, expected_cores=None):
+        if min(rtol, atol) < 0 or not all(math.isfinite(x) for x in (rtol, atol)):
+            raise ValueError("tolerances must be finite and non-negative")
+        if not math.isfinite(timeout_seconds) or timeout_seconds <= 0:
+            raise ValueError("segment timeout must be finite and positive")
+        self.kernel = Path(kernel).expanduser().resolve()
+        if not self.kernel.is_file():
+            raise ValueError(f"kernel object not found: {self.kernel}")
+        self.run_dir = Path(run_dir).expanduser().resolve()
+        self.cann_home = Path(cann_home).expanduser().resolve()
+        self.rtol, self.atol = rtol, atol
+        self.timeout_seconds = timeout_seconds
+        self.operator = GemmCase()
+        if expected_cores is not None:
+            cores = frozenset(expected_cores)
+            if not cores or not cores <= {"AIC", "AIV0", "AIV1"} or "AIC" not in cores:
+                raise ValueError("GEMM expected_cores must include AIC and only valid subcores")
+            self.operator.expected_cores = cores
+        self.config = SimpleNamespace(kind="gemm", seq_len=64, blocks=1)
+        self.reports = []
+        self.kernel_sha256 = sha256(self.kernel)
+        self.run_dir.mkdir(parents=True, exist_ok=True)
+        self.segment_dir = self.run_dir / "segments"
+        self.segment_dir.mkdir(exist_ok=True)
+        self.runner_source = Path(build_runner(self.cann_home, self.operator.runner_target)).resolve()
+        # Keep the built Host stable if another invocation rebuilds the shared build/.
+        self.build_snapshot = Path(tempfile.mkdtemp(prefix="segment_host_", dir=self.run_dir))
+        self.runner_snapshot = self.build_snapshot / self.runner_source.name
+        shutil.copy2(self.runner_source, self.runner_snapshot)
+        self.runner_sha256 = sha256(self.runner_snapshot)
+        self._mix_fix_template = prepare_mix_scheduler_fix(
+            self.cann_home, mix_scheduler_fix, self.config.blocks, self.operator.expected_cores
+        )
+
+    def execute(self, rank, segment_id, a_bits, b_bits):
+        """Run one GEMM and fail closed on recording, accuracy, repair, or trace errors."""
+        if type(rank) is not int or rank < 0:
+            raise ValueError("rank must be a non-negative integer")
+        if not isinstance(segment_id, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", segment_id):
+            raise ValueError("segment_id must be 1–96 filesystem-safe letters/digits/_.- and start with a letter or digit")
+        inputs = {"a": a_bits, "b": b_bits}
+        for name, value in inputs.items():
+            if not isinstance(value, np.ndarray) or value.shape != (64, 64) or value.dtype != np.dtype("<u2"):
+                raise ValueError(f"{name} must contain raw little-endian BF16 uint16 bits with shape (64, 64)")
+        run_dir = Path(tempfile.mkdtemp(prefix=f"rank{rank}_{segment_id}_", dir=self.segment_dir))
+        data_dir = run_dir / "inputs"
+        data_dir.mkdir()
+        for name, value in inputs.items():
+            np.ascontiguousarray(value).tofile(data_dir / f"{name}.bin")
+        input_hashes = {name: sha256(data_dir / f"{name}.bin") for name in inputs}
+        write_json(
+            data_dir / "inputs.json",
+            {
+                "kind": "gemm",
+                "seq_len": 64,
+                "rank": rank,
+                "segment_id": segment_id,
+                "source": "host protocol model segment boundary",
+                "files": {f"{name}.bin": {"shape": [64, 64], "dtype": "<u2", "sha256": digest} for name, digest in input_hashes.items()},
+            },
+        )
+        # record_environment mutates loaded-library fields; no previous segment's
+        # paths or verification result may be reused in a subsequent recording.
+        mix_fix = copy.deepcopy(self._mix_fix_template)
+        output_file = run_dir / "gemm_output.bin"
+        manifest_path = run_dir / "manifest.json"
+        manifest = {
+            "kind": "gemm",
+            "seq_len": 64,
+            "blocks": 1,
+            "rank": rank,
+            "segment_id": segment_id,
+            "run_dir": str(run_dir),
+            "manifest_path": str(manifest_path),
+            "execution_model": "single-device CANN segment",
+            "kernel": str(self.kernel),
+            "kernel_sha256": self.kernel_sha256,
+            "soc": SOC_VERSION,
+            "recorded_core": 0,
+            "expected_cores": sorted(self.operator.expected_cores),
+            "instruction_log": str(run_dir / "instructions.bin"),
+            "runner_source": str(self.runner_source),
+            "runner_snapshot": str(self.runner_snapshot),
+            "runner_sha256": self.runner_sha256,
+            "output": str(output_file),
+            "output_shape": [64, 64],
+            "data_dir": str(data_dir),
+            "python": sys.executable,
+            "python_version": sys.version.split()[0],
+            "cann_home": str(self.cann_home),
+            "input_sha256": input_hashes,
+            "timeout_seconds": self.timeout_seconds,
+            "record_timed_out": False,
+            "record_interrupted": False,
+            "record_returncode": None,
+            "record_command": [],
+            "accuracy": {"status": "pending"},
+            "report_complete": False,
+            "mix_scheduler_fix": mix_fix,
+            "passed": False,
+            "errors": [],
+        }
+        write_json(manifest_path, manifest)
+        start = time.monotonic()
+        manifest["record_started_unix_ns"] = time.time_ns()
+        try:
+            # Reject invalid BF16 values before entering the native runner.
+            load_inputs(data_dir, self.operator, self.config)
+            if sha256(self.kernel) != self.kernel_sha256:
+                raise ValueError("kernel object changed after executor initialization")
+            runner = isolate_runner(self.runner_snapshot, run_dir)
+            if sha256(runner) != self.runner_sha256:
+                raise ValueError("runner snapshot changed after executor initialization")
+            environment = record_environment(self.cann_home, run_dir, mix_fix)
+            command = [
+                str(runner),
+                "--kernel",
+                str(self.kernel),
+                "--kind",
+                "gemm",
+                "--seq-len",
+                "64",
+                "--blocks",
+                "1",
+                "--output",
+                str(output_file),
+                "--data-dir",
+                str(data_dir),
+            ]
+            manifest.update(runner=str(runner), record_command=command)
+            write_json(manifest_path, manifest)
+            with (run_dir / "record.log").open("w") as log:
+                process = subprocess.Popen(
+                    command, cwd=runner.parent, env=environment, stdout=log, stderr=subprocess.STDOUT, start_new_session=True
+                )
+                try:
+                    manifest["record_returncode"] = process.wait(timeout=self.timeout_seconds)
+                except subprocess.TimeoutExpired:
+                    manifest["record_timed_out"] = True
+                    # End the entire process group, including simulator subprocesses.
+                    # A new session ensures the parent's shell and other ranks are excluded.
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    manifest["record_returncode"] = process.wait()
+                    manifest["errors"].append(f"recording exceeded {self.timeout_seconds:g} seconds")
+                except BaseException as error:
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    manifest["record_returncode"] = process.wait()
+                    manifest["record_interrupted"] = True
+                    manifest["errors"].append(f"recording interrupted: {type(error).__name__}")
+                    raise
+            if manifest["record_returncode"] != 0:
+                manifest["errors"].append(f"runner exited with status {manifest['record_returncode']}")
+        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
+            manifest["errors"].append(f"recording failed: {error}")
+            with (run_dir / "record.log").open("a") as log:
+                log.write(f"ERROR: {error}\n")
+        finally:
+            manifest["record_seconds"] = time.monotonic() - start
+            manifest["record_finished_unix_ns"] = time.time_ns()
+            if manifest["record_interrupted"]:
+                # Keep the interruption evidence even though the worker exits
+                # before running the ordinary accuracy/trace finalization.
+                write_json(manifest_path, manifest)
+
+        try:
+            mix_verification = validate_mix_scheduler_fix(mix_fix, run_dir, self.config.blocks)
+        except (OSError, ValueError, KeyError, TypeError) as error:
+            mix_verification = {"passed": False, "status": "failed", "error": str(error)}
+        mix_fix["verification"] = mix_verification
+        if not mix_verification["passed"]:
+            manifest["errors"].append(f"MIX validation failed: {mix_verification.get('error', 'incomplete evidence')}")
+        try:
+            accuracy = check_output(data_dir, output_file, self.operator, self.config, self.rtol, self.atol)
+            manifest["output_sha256"] = accuracy["output_sha256"]
+        except (OSError, ValueError, KeyError) as error:
+            accuracy = {"passed": False, "error": str(error)}
+        manifest["accuracy"] = accuracy
+        if not accuracy["passed"]:
+            manifest["errors"].append(f"accuracy failed: {accuracy.get('error', str(accuracy.get('mismatches')) + ' mismatches')}")
+        write_json(run_dir / "accuracy.json", accuracy)
+        write_json(manifest_path, manifest)
+        # Even timeout, native failure, or wrong output must retain available traces.
+        try:
+            report = export_traces(run_dir, self.operator.expected_cores)
+        except (OSError, ValueError, subprocess.SubprocessError) as error:
+            report = {"report_complete": False, "report_error": str(error)}
+        manifest.update(report)
+        if not report["report_complete"]:
+            manifest["errors"].append(f"trace failed: {report.get('report_error', 'incomplete trace')}")
+        manifest["passed"] = not manifest["errors"] and manifest["record_returncode"] == 0 and not manifest["record_timed_out"]
+        write_json(manifest_path, manifest)
+        self.reports.append(manifest)
+        if not manifest["passed"]:
+            raise SegmentExecutionError(manifest)
+        return np.fromfile(output_file, dtype="<f4").reshape(64, 64)
diff --git a/cosim/worker.py b/cosim/worker.py
new file mode 100644
index 0000000..c327b9e
--- /dev/null
+++ b/cosim/worker.py
@@ -0,0 +1,80 @@
+"""JSON-lines bridge for compilers using a different Python interpreter.
+
+The worker uses the helper's own environment and never executes supplied code.
+Diagnostics go to stderr; stdout contains one JSON response per request.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+
+import numpy as np
+
+from cosim.segments import GemmSegmentExecutor
+from utils.environment import prepare_environment
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--kernel", required=True, type=Path)
+    parser.add_argument("--run-dir", required=True, type=Path)
+    parser.add_argument("--expected-cores", nargs="+", required=True)
+    parser.add_argument("--timeout", type=float, default=120)
+    args = parser.parse_args()
+    # Python's redirect_stdout cannot redirect CMake or native library writes.
+    # Keep a private pipe descriptor for the protocol and move fd 1 to stderr
+    # before constructing the executor, whose build spawns native subprocesses.
+    sys.stdout.flush()
+    wire_fd = os.dup(1)
+    os.set_inheritable(wire_fd, False)
+    os.dup2(2, 1)
+
+    def terminate(signum, _frame):
+        # Let the executor's BaseException path kill its independently created
+        # native process group before this worker exits.
+        raise SystemExit(128 + signum)
+
+    signal.signal(signal.SIGTERM, terminate)
+    with os.fdopen(wire_fd, "w", encoding="utf-8", buffering=1) as wire:
+
+        def respond(value):
+            print(json.dumps(value, allow_nan=False), file=wire, flush=True)
+
+        try:
+            executor = GemmSegmentExecutor(
+                args.kernel, args.run_dir, prepare_environment(), expected_cores=args.expected_cores, timeout_seconds=args.timeout
+            )
+            respond({"ready": True})
+        except Exception as error:
+            respond({"ready": False, "error": f"{type(error).__name__}: {error}"})
+            return 1
+        for line in sys.stdin:
+            try:
+                request = json.loads(line)
+                if not isinstance(request, dict):
+                    raise ValueError("request must be a JSON object")
+                if request.get("op") == "close":
+                    return 0
+                if request.get("op") != "execute":
+                    raise ValueError("expected execute or close")
+                a = np.fromfile(request["a"], dtype="<u2").reshape(64, 64)
+                b = np.fromfile(request["b"], dtype="<u2").reshape(64, 64)
+                count = len(executor.reports)
+                try:
+                    executor.execute(request["rank"], request["segment_id"], a, b)
+                    response = {"passed": True, "manifest": executor.reports[-1]}
+                except Exception as error:
+                    response = {"passed": False, "error": str(error)}
+                    if len(executor.reports) > count:
+                        response["manifest"] = executor.reports[-1]
+            except Exception as error:
+                response = {"passed": False, "error": f"{type(error).__name__}: {error}"}
+            respond(response)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
