+        yield WaitSignal(ready, value, (dst,))
+        event = yield Compute("read", (dst,), (BufferRef(1, "out"),), lambda data: (data,), ticks=4)
+        yield Signal(ack, value, (dst,))
+        yield Wait(event)
+        yield Quiet()
+
+    def test_slots_and_delayed_consumers_across_seeds(self):
+        for slots in (1, 2, 3):
