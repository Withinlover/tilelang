+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from cosim.protocol import (
+    BufferRef,
+    Compute,
+    CopyAsync,
+    DeadlockError,
+    Delay,
+    ProtocolError,
+    PutSignal,
+    Quiet,
+    Signal,
+    SignalRef,
+    Simulator,
+    Wait,
+    WaitSignal,
+    Write,
+)
+
+
+def array(value):
+    return np.full((2, 2), value, dtype=np.float32)
+
+
+def exchange(seed=0, rounds=4, slots=2, fault=None, consumer_ticks=3):
+    sim = Simulator(seed=seed, fault=fault)
+    for rank in range(2):
+        for slot in range(slots):
+            sim.register_buffer(BufferRef(rank, "send", slot), array(-1))
+            sim.register_buffer(BufferRef(rank, "recv", slot), array(-2))
+            sim.register_signal(SignalRef(rank, "ready", slot))
+            sim.register_signal(SignalRef(rank, "ack", slot))
+        sim.register_buffer(BufferRef(rank, "out"), array(0))
+    seen = {0: [], 1: []}
+
+    def program(rank):
+        peer = 1 - rank
+        for iteration in range(rounds):
+            slot, epoch = iteration % slots, iteration + 1
+            send, recv = BufferRef(rank, "send", slot), BufferRef(rank, "recv", slot)
+            if iteration >= slots:
+                yield WaitSignal(SignalRef(rank, "ack", slot), epoch - slots)
+            yield Write(send, array(100 * rank + epoch))
+            event = yield PutSignal(send, BufferRef(peer, "recv", slot), SignalRef(peer, "ready", slot), epoch)
+            yield Wait(event)
+            yield WaitSignal(SignalRef(rank, "ready", slot), epoch, (recv,))
+
+            def consume(data, r=rank, e=epoch):
+                seen[r].append(data.copy())
+                np.testing.assert_array_equal(data, array(100 * (1 - r) + e))
+                return (data.copy(),)
+
+            event = yield Compute("consumer", (recv,), (BufferRef(rank, "out"),), consume, ticks=consumer_ticks + rank)
+            # Deliberately omit Wait: ACK's release_regions must join this reader.
+            yield Signal(SignalRef(peer, "ack", slot), epoch, (recv,))
+        for slot in range(min(slots, rounds)):
+            last = max(i + 1 for i in range(rounds) if i % slots == slot)
+            yield WaitSignal(SignalRef(rank, "ack", slot), last)
+        yield Quiet()
+
+    sim.run({0: program(0), 1: program(1)})
+    return sim, seen
+
+
+class ProtocolTests(unittest.TestCase):
+    def setup_pair(self, **kwargs):
+        sim = Simulator(**kwargs)
+        src, dst = BufferRef(0, "source"), BufferRef(1, "recv")
+        ready, ack = SignalRef(1, "ready"), SignalRef(0, "ack")
+        sim.register_buffer(src, array(1))
+        sim.register_buffer(dst, array(0))
+        sim.register_buffer(BufferRef(1, "out"), array(0))
+        sim.register_signal(ready)
+        sim.register_signal(ack)
+        return sim, src, dst, ready, ack
+
+    def receiver(self, dst, ready, ack, value=1, delay=0):
+        if delay:
