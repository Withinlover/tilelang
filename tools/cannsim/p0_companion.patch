@@ -0,0 +1,710 @@
+"""CPU model of rank protocols; ticks are logical and have no physical unit.
+
+Each buffer is an independent, whole-array region. This models explicit READY / ACK
+slot protocols, not caches, interconnects, or simultaneous CANN devices. Publication
+leases deliberately require ACK acquisition before reuse, including at run exit.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import heapq
+import random
+from typing import Callable, Generator, Mapping
+
+import numpy as np
+
+
+class ProtocolError(RuntimeError):
+    """A modeled memory, epoch, or ownership rule was violated."""
+
+
+class DeadlockError(ProtocolError):
+    """No runnable rank or future event can satisfy the remaining waits."""
+
+
+@dataclass(frozen=True)
+class BufferRef:
+    rank: int
+    name: str
+    slot: int = 0
+
+    def __str__(self):
+        return f"r{self.rank}:{self.name}[{self.slot}]"
+
+
+@dataclass(frozen=True)
+class SignalRef:
+    rank: int
+    name: str
+    slot: int = 0
+
+    def __str__(self):
+        return f"r{self.rank}:{self.name}[{self.slot}]"
+
+
+@dataclass(frozen=True)
+class Write:
+    ref: BufferRef
+    data: np.ndarray
+
+
+@dataclass(frozen=True)
+class CopyAsync:
+    src: BufferRef
+    dst: BufferRef
+
+
+@dataclass(frozen=True)
+class PutSignal:
+    src: BufferRef
+    dst: BufferRef
+    signal: SignalRef
+    value: int
+
+
+@dataclass(frozen=True)
+class Wait:
+    event: Event
+    completion: str = "local"
+
+
+@dataclass(frozen=True)
+class Signal:
+    ref: SignalRef
+    value: int
+    release_regions: tuple[BufferRef, ...] = ()
+
+
+@dataclass(frozen=True)
+class WaitSignal:
+    ref: SignalRef
+    value: int
+    covers: tuple[BufferRef, ...] = ()
+
+
+@dataclass(frozen=True)
+class Compute:
+    name: str
+    reads: tuple[BufferRef, ...]
+    writes: tuple[BufferRef, ...]
+    callback: Callable
+    ticks: int = 1
+
+
+@dataclass(frozen=True)
+class Delay:
+    ticks: int
+
+
+@dataclass(frozen=True)
+class Quiet:
+    pass
+
+
+@dataclass
+class Event:
+    id: int
+    rank: int
+    kind: str
+    local_done: bool = False
+    remote_done: bool = False
+    payload_done: bool = False
+    src: BufferRef | None = None
+    dst: BufferRef | None = None
+    lease: int | None = None
+
+
+@dataclass
+class _Buffer:
+    data: np.ndarray
+    version: int = 0
+    readers: set[int] = field(default_factory=set)
+    writers: set[int] = field(default_factory=set)
+
+
+@dataclass
+class _Signal:
+    value: int
+    issued: int
+    writer: int | None = None
+    publications: tuple[int, ...] = ()
+    acknowledgements: tuple[int, ...] = ()
+
+
+@dataclass
+class _Lease:
+    id: int
+    kind: str
+    ref: BufferRef
+    publisher: int
+    consumer: int
+    epoch: int | None
+    version: int | None = None
+    acquired: bool = False
+    consumed: bool = False
+    ack_sent: bool = False
+    ack_acquired: bool = False
+
+
+@dataclass
+class _Rank:
+    program: Generator
+    started: bool = False
+    done: bool = False
+    result: object = None
+    blocked: object = None
+
+
+class Simulator:
+    """Deterministic discrete-event interpreter for explicitly declared regions.
+
+    ``Compute`` is asynchronous; its callback receives positional read snapshots
+    and returns one tuple entry per write. A callback may invoke a real single-card
+    simulator. The wall time spent in that callback never changes logical ticks.
+    Faults are injected once per run: early_ready, drop_signal, drop_ack, or
+    corrupt_payload. The latter preserves source data and protocol ordering.
+    """
+
+    def __init__(self, seed=0, min_delay=1, max_delay=4, fault=None, max_steps=100000):
+        if not 1 <= min_delay <= max_delay:
+            raise ValueError("require 1 <= min_delay <= max_delay")
+        if fault not in (None, "early_ready", "drop_signal", "drop_ack", "corrupt_payload"):
+            raise ValueError(f"unknown fault: {fault}")
+        self.seed, self.min_delay, self.max_delay = seed, min_delay, max_delay
+        self.fault, self.max_steps = fault, max_steps
+        self._rng = random.Random(seed)
+        self._buffers: dict[BufferRef, _Buffer] = {}
+        self._signals: dict[SignalRef, _Signal] = {}
+        self._events: dict[int, Event] = {}
+        self._leases: dict[int, _Lease] = {}
+        self._ranks: dict[int, _Rank] = {}
+        self._queue = []
+        self._deferred = []
+        self._sequence = 0
+        self._fault_used = False
+        self._ran = False
+        self._passed = False
+        self._error = None
+        self.now = 0
+        self.trace_events: list[dict] = []
+
+    def register_buffer(self, ref: BufferRef, data: np.ndarray):
+        if self._ran or ref in self._buffers:
+            raise ValueError(f"buffer already registered or run started: {ref}")
+        self._validate_ref(ref)
+        array = np.asarray(data)
+        if array.dtype.hasobject:
+            raise ValueError("object buffers are unsupported")
+        self._buffers[ref] = _Buffer(np.array(array, copy=True, order="C"))
+
+    def register_signal(self, ref: SignalRef, value=0):
+        if self._ran or ref in self._signals:
+            raise ValueError(f"signal already registered or run started: {ref}")
+        self._validate_ref(ref)
+        self._check_epoch(value, initial=True)
+        self._signals[ref] = _Signal(value, value)
+
+    @staticmethod
+    def _validate_ref(ref):
+        if not isinstance(ref.rank, int) or ref.rank < 0 or not isinstance(ref.slot, int) or ref.slot < 0:
+            raise ValueError("rank and slot must be nonnegative integers")
+        if not isinstance(ref.name, str) or not ref.name:
+            raise ValueError("region name must be nonempty")
+
+    @staticmethod
+    def _check_epoch(value, initial=False):
+        if isinstance(value, bool) or not isinstance(value, int) or value < (0 if initial else 1):
+            raise ProtocolError("epoch must be a positive integer (initial value may be zero)")
+        if value >= 2**64:
+            raise ProtocolError("epoch would wrap uint64")
+
+    def _trace(self, name, rank, **args):
+        self.trace_events.append({"name": name, "ph": "i", "s": "t", "ts": self.now, "pid": rank, "tid": "protocol", "args": args})
+
+    def _schedule(self, ticks, callback):
+        self._sequence += 1
+        heapq.heappush(self._queue, (self.now + ticks, self._sequence, callback))
+
+    def _delay(self):
+        return self._rng.randint(self.min_delay, self.max_delay)
+
+    def _event(self, rank, kind, **kwargs):
+        event = Event(len(self._events) + 1, rank, kind, **kwargs)
+        self._events[event.id] = event
+        return event
+
+    def _prefix(self, rank):
+        # Keep events after local wait: local completion does not remove a put
+        # from the release prefix before its remote completion.
+        return tuple(e for e in self._events.values() if e.rank == rank and e.kind != "compute")
+
+    @staticmethod
+    def _complete(event):
+        return event.local_done if event.kind in ("get", "compute") else event.remote_done
+
+    def _buffer(self, ref):
+        try:
+            return self._buffers[ref]
+        except KeyError as error:
+            raise ProtocolError(f"unregistered buffer: {ref}") from error
+
+    def _signal(self, ref):
+        try:
+            return self._signals[ref]
+        except KeyError as error:
+            raise ProtocolError(f"unregistered signal: {ref}") from error
+
+    def _active_leases(self, ref):
+        return [lease for lease in self._leases.values() if lease.ref == ref and not lease.ack_acquired]
+
+    def _check_write(self, ref):
+        buffer = self._buffer(ref)
+        if buffer.readers or buffer.writers:
+            raise ProtocolError(f"write races with in-flight access to {ref}")
+        leases = self._active_leases(ref)
+        if leases:
+            lease = leases[0]
+            raise ProtocolError(
+                f"slot/source reuse before ACK acquire: {ref}, epoch {lease.epoch}, lease {lease.kind} for rank {lease.consumer}"
+            )
+
+    def _check_read(self, ref, rank):
+        buffer = self._buffer(ref)
+        if buffer.writers:
+            raise ProtocolError(f"read before local completion or payload arrival: {ref}")
+        for lease in self._leases.values():
+            if lease.ref != ref:
+                continue
+            if lease.ack_acquired and lease.version != buffer.version:
+                continue
+            if lease.kind == "put" and lease.consumer == rank:
+                if not lease.acquired:
+                    raise ProtocolError(f"read without READY acquire/covers: {ref}, epoch {lease.epoch}")
+                if lease.ack_sent:
+                    raise ProtocolError(f"read after ACK released consumer lease: {ref}")
+                if lease.version != buffer.version:
+                    raise ProtocolError(f"wrong payload generation in {ref}: expected version {lease.version}, observed {buffer.version}")
+
+    def _store(self, ref, data):
+        buffer = self._buffer(ref)
+        array = np.asarray(data)
+        if array.shape != buffer.data.shape or array.dtype != buffer.data.dtype:
+            raise ProtocolError(
+                f"shape/dtype mismatch for {ref}: expected {buffer.data.shape}/{buffer.data.dtype}, got {array.shape}/{array.dtype}"
+            )
+        buffer.data[...] = array
+        buffer.version += 1
+
+    def _new_lease(self, kind, ref, publisher, consumer, epoch, version=None):
+        lease = _Lease(len(self._leases) + 1, kind, ref, publisher, consumer, epoch, version)
+        self._leases[lease.id] = lease
+        self._trace("lease_open", publisher, region=str(ref), kind=kind, consumer=consumer, epoch=epoch)
+        return lease
+
+    def _reserve_signal(self, rank, ref, value):
+        self._check_epoch(value)
+        if ref.rank == rank:
+            raise ProtocolError("signal must target a remote rank")
+        signal = self._signal(ref)
+        if signal.writer not in (None, rank):
+            raise ProtocolError(f"signal has multiple writers: {ref}")
+        if value <= signal.issued:
+            raise ProtocolError(f"signal epoch must increase: {ref}, {value} <= {signal.issued}")
+        signal.writer, signal.issued = rank, value
+
+    def _use_fault(self, kind, rank, **details):
+        if self.fault == kind and not self._fault_used:
+            self._fault_used = True
+            self._trace("fault_injected", rank, fault=kind, **details)
+            return True
+        return False
+
+    def _send_signal(self, rank, ref, value, publications, acknowledgements, event, delay=None):
+        # Signals in one channel are ordered by the prefix dependency. Publication
+        # metadata belongs to the signal value actually observed, not to history.
+        if (self._use_fault("drop_ack", rank, signal=str(ref)) if acknowledgements else False) or self._use_fault(
+            "drop_signal", rank, signal=str(ref)
+        ):
+            return
+
+        def deliver():
+            signal = self._signal(ref)
+            if value <= signal.value:
+                raise ProtocolError(f"signal delivery regressed: {ref}")
+            signal.value = value
+            signal.publications = tuple(publications)
+            signal.acknowledgements = tuple(acknowledgements)
+            event.local_done = event.remote_done = event.payload_done = True
+            self._trace(
+                "signal_arrive",
+                rank,
+                destination=str(ref),
+                epoch=value,
+                publications=list(publications),
+                acknowledgements=list(acknowledgements),
+            )
+            for lease_id in publications:
+                lease = self._leases[lease_id]
+                if lease.version is None or self._buffer(lease.ref).writers:
+                    raise ProtocolError(f"READY arrived before payload completion: {lease.ref}")
+
+        self._trace("signal_issue", rank, destination=str(ref), epoch=value)
+        self._schedule(self._delay() if delay is None else delay, deliver)
+
+    def _copy(self, rank, op, signal_op=None):
+        src, dst = op.src, op.dst
+        if src.rank == dst.rank or rank not in (src.rank, dst.rank):
+            raise ProtocolError("copy must cross ranks and be issued by source (put) or destination (get)")
+        kind = "put" if src.rank == rank else "get"
+        source, destination = self._buffer(src), self._buffer(dst)
+        if source.data.shape != destination.data.shape or source.data.dtype != destination.data.dtype:
+            raise ProtocolError("copy shape/dtype mismatch")
+        self._check_read(src, rank)
+        self._check_write(dst)
+        lease = None
+        if kind == "get":
+            candidates = [
+                x for x in self._active_leases(src) if x.kind == "get_source" and x.consumer == rank and x.acquired and not x.ack_sent
+            ]
+            if len(candidates) != 1 or candidates[0].version != source.version:
+                raise ProtocolError(f"get requires an acquired, stable source lease: {src}")
+            lease = candidates[0]
+        prefix = self._prefix(rank)
+        if signal_op is not None:
+            if kind != "put" or signal_op.signal.rank != dst.rank:
+                raise ProtocolError("put_signal must publish to the destination rank")
+            self._reserve_signal(rank, signal_op.signal, signal_op.value)
+        if kind == "put":
+            # An unbound publication lease begins at issue, before READY exists.
+            # Remote completion alone never authorizes receiver consumption.
+            lease = self._new_lease("put", dst, rank, dst.rank, signal_op.value if signal_op is not None else None)
+        event = self._event(rank, kind, src=src, dst=dst, lease=lease.id if lease else None)
+        source.readers.add(event.id)
+        destination.writers.add(event.id)
+        self._trace(f"{kind}_issue", rank, event=event.id, source=str(src), destination=str(dst))
+        staging = {}
+
+        def snapshot():
+            staging["data"] = source.data.copy()
+            if self._use_fault("corrupt_payload", rank, event=event.id):
+                flat = staging["data"].reshape(-1)
+                if flat.size:
+                    if flat.dtype == np.dtype("uint16"):
+                        flat[0] = 0x4040 if flat[0] == 0x4000 else 0x4000
+                    else:
+                        flat[0] += 2
+            source.readers.remove(event.id)
+
+        def local_complete():
+            snapshot()
+            event.local_done = True
+            self._trace("local_complete", rank, event=event.id, kind=kind)
+
+        def payload_complete():
+            if kind == "get":
+                snapshot()
+            self._store(dst, staging["data"])
+            destination.writers.remove(event.id)
+            event.payload_done = True
+            if kind == "get":
+                event.local_done = True
+                lease.consumed = True
+                self._trace("local_complete", rank, event=event.id, kind=kind)
+            elif signal_op is None:
+                event.remote_done = True
+            if kind == "put":
+                lease.version = destination.version
+            self._trace("payload_arrive", rank, event=event.id, destination=str(dst), version=destination.version)
+
+        local_delay = self._delay()
+        if kind == "put":
+            self._schedule(local_delay, local_complete)
+        self._schedule(local_delay + self._delay(), payload_complete)
+        if signal_op is not None:
+            early = self._use_fault("early_ready", rank, event=event.id)
+            ready = lambda: early or (event.payload_done and all(self._complete(e) for e in prefix))
+
+            def publish():
+                publications = self._bind_put_publications(prefix, dst.rank, signal_op.value)
+                self._send_signal(rank, signal_op.signal, signal_op.value, [*publications, lease.id], [], event, delay=0 if early else None)
+
+            self._deferred.append((ready, publish))
+        return event
+
+    def _bind_put_publications(self, prefix, peer, epoch):
+        publications = []
+        for event in prefix:
+            if event.kind == "put" and event.dst.rank == peer:
+                lease = self._leases[event.lease]
+                if lease.epoch is None:
+                    lease.epoch = epoch
+                    publications.append(lease.id)
+        return publications
+
+    def _issue_signal(self, rank, op):
+        self._reserve_signal(rank, op.ref, op.value)
+        publications, acknowledgements = [], []
+        for ref in op.release_regions:
+            if ref.rank != rank:
+                raise ProtocolError("release_regions must be local")
+            buffer = self._buffer(ref)
+            incoming = [
+                x
+                for x in self._active_leases(ref)
+                if x.kind == "put"
+                and x.consumer == rank
+                and x.publisher == op.ref.rank
+                and x.epoch == op.value
+                and x.acquired
+                and not x.ack_sent
+            ]
+            if incoming:
+                acknowledgements.extend(x.id for x in incoming)
+            else:
+                if self._active_leases(ref):
+                    raise ProtocolError(f"cannot republish a leased source or acknowledge an unacquired payload: {ref}")
+                publications.append(self._new_lease("get_source", ref, rank, op.ref.rank, op.value, buffer.version).id)
+        # Completed get requests release the acquired remote source through a
+        # control-only ACK; local destination computation does not hold that source.
+        acknowledgements.extend(
+            x.id
+            for x in self._leases.values()
+            if x.kind == "get_source"
+            and x.consumer == rank
+            and x.publisher == op.ref.rank
+            and x.epoch == op.value
+            and x.acquired
+            and x.consumed
+            and not x.ack_sent
+            and not x.ack_acquired
+        )
+        # Publish any earlier plain puts to this peer, even when their local wait
+        # has already returned. This is the release-prefix rule for covers=[Recv].
+        publications.extend(self._bind_put_publications(self._prefix(rank), op.ref.rank, op.value))
+        for lease_id in acknowledgements:
+            lease = self._leases[lease_id]
+            if self._buffer(lease.ref).readers:
+                raise ProtocolError(f"ACK before consumer/source reads complete: {lease.ref}")
+            lease.ack_sent = True
+        event = self._event(rank, "signal")
+        self._send_signal(rank, op.ref, op.value, publications, acknowledgements, event)
+
+    def _acquire(self, rank, op):
+        signal = self._signal(op.ref)
+        self._check_epoch(op.value)
+        if op.ref.rank != rank:
+            raise ProtocolError("wait_signal must target a local signal")
+        if signal.value < op.value:
+            return False
+        for ref in op.covers:
+            candidates = [self._leases[i] for i in signal.publications if self._leases[i].ref == ref and self._leases[i].consumer == rank]
+            if len(candidates) != 1:
+                raise ProtocolError(f"covers has no matching release publication: {ref}")
+            lease, buffer = candidates[0], self._buffer(ref)
+            # >= is sufficient for control waits. Covered reusable slots must not
+            # silently substitute a newer generation for the requested one.
+            if lease.epoch != op.value:
+                raise ProtocolError(f"wrong payload epoch for {ref}: requested {op.value}, observed {lease.epoch}")
+            if lease.ack_sent or lease.ack_acquired:
+                raise ProtocolError(f"acquire after payload lease was acknowledged: {ref}")
+            if lease.version is None or buffer.writers:
+                raise ProtocolError(f"READY arrived before payload completion: {ref}")
+            if lease.version != buffer.version:
+                raise ProtocolError(f"wrong payload generation: {ref}")
+            lease.acquired = True
+        for lease_id in signal.acknowledgements:
+            lease = self._leases[lease_id]
+            if lease.publisher != rank:
+                raise ProtocolError("ACK acquired by wrong publisher")
+            lease.ack_acquired = True
+            self._trace("lease_close", rank, region=str(lease.ref), epoch=lease.epoch)
+        self._trace(
+            "signal_acquire",
+            rank,
+            signal=str(op.ref),
+            requested_epoch=op.value,
+            observed_epoch=signal.value,
+            covers=[str(r) for r in op.covers],
+        )
+        return True
+
+    def _compute(self, rank, op):
+        if not isinstance(op.ticks, int) or op.ticks < 1:
+            raise ProtocolError("compute ticks must be positive")
+        if len(set(op.writes)) != len(op.writes):
+            raise ProtocolError("compute writes must be distinct regions")
+        for ref in (*op.reads, *op.writes):
+            if ref.rank != rank:
+                raise ProtocolError("compute accesses must be local")
+        for ref in op.reads:
+            self._check_read(ref, rank)
+        for ref in op.writes:
+            self._check_write(ref)
+        event = self._event(rank, "compute")
+        snapshots = [self._buffer(ref).data.copy() for ref in op.reads]
+        for ref in op.reads:
+            self._buffer(ref).readers.add(event.id)
+        for ref in op.writes:
+            self._buffer(ref).writers.add(event.id)
+        self._trace(
+            "compute_begin", rank, event=event.id, operation=op.name, reads=[str(r) for r in op.reads], writes=[str(r) for r in op.writes]
+        )
+
+        def finish():
+            values = op.callback(*snapshots)
+            if not isinstance(values, (tuple, list)) or len(values) != len(op.writes):
+                raise ProtocolError("compute callback must return one tuple/list entry per write region")
+            # Validate before mutating any destination.
+            for ref, value in zip(op.writes, values):
+                buffer, array = self._buffer(ref), np.asarray(value)
+                if array.shape != buffer.data.shape or array.dtype != buffer.data.dtype:
+                    raise ProtocolError(f"compute shape/dtype mismatch for {ref}")
+            for ref in op.reads:
+                self._buffer(ref).readers.discard(event.id)
+                for lease in self._active_leases(ref):
+                    if lease.kind == "put" and lease.consumer == rank:
+                        lease.consumed = True
+            for ref, value in zip(op.writes, values):
+                self._buffer(ref).writers.remove(event.id)
+                self._store(ref, value)
+            event.local_done = event.remote_done = event.payload_done = True
+            self._trace("compute_end", rank, event=event.id, operation=op.name)
+
+        self._schedule(op.ticks, finish)
+        return event
+
+    def _wait_ready(self, rank, op):
+        if isinstance(op, Wait):
+            event = op.event
+            if self._events.get(event.id) is not event or event.rank != rank:
+                raise ProtocolError("event does not belong to the waiting rank/run")
+            if op.completion not in ("local", "remote"):
+                raise ProtocolError("completion must be local or remote")
+            if op.completion == "remote" and event.kind in ("get", "compute"):
+                raise ProtocolError(f"{event.kind} does not support remote completion")
+            ready = event.local_done if op.completion == "local" else event.remote_done
+            if ready:
+                self._trace("event_wait", rank, event=event.id, completion=op.completion)
+            return ready
+        if isinstance(op, WaitSignal):
+            return self._acquire(rank, op)
+        if isinstance(op, Signal):
+            if all(self._complete(e) for e in self._prefix(rank)) and all(
+                not self._buffer(ref).readers and not self._buffer(ref).writers for ref in op.release_regions
+            ):
+                self._issue_signal(rank, op)
+                return True
+            return False
+        if isinstance(op, Quiet):
+            return all(self._complete(e) for e in self._prefix(rank))
+        if isinstance(op, Delay):
+            return self.now >= self._ranks[rank].result
+        raise ProtocolError(f"unsupported blocking operation: {op!r}")
+
+    def _execute(self, rank, op):
+        state = self._ranks[rank]
+        if isinstance(op, Write):
+            if op.ref.rank != rank:
+                raise ProtocolError("Write requires a local region")
+            self._check_write(op.ref)
+            self._store(op.ref, op.data)
+            self._trace("write", rank, region=str(op.ref), version=self._buffer(op.ref).version)
+        elif isinstance(op, (CopyAsync, PutSignal)):
+            state.result = self._copy(rank, op, op if isinstance(op, PutSignal) else None)
+        elif isinstance(op, Compute):
+            state.result = self._compute(rank, op)
+        elif isinstance(op, (Wait, WaitSignal, Signal, Quiet, Delay)):
+            if isinstance(op, Delay):
+                if not isinstance(op.ticks, int) or op.ticks < 0:
+                    raise ProtocolError("delay ticks must be nonnegative")
+                state.result = self.now + op.ticks
+                self._schedule(op.ticks, lambda: None)
+            if not self._wait_ready(rank, op):
+                state.blocked = op
+            else:
+                state.result = None
+        else:
+            raise ProtocolError(f"unsupported operation from rank {rank}: {op!r}")
+
+    def _flush(self):
+        progressed = True
+        while progressed:
+            progressed = False
+            while self._queue and self._queue[0][0] <= self.now:
+                _, _, callback = heapq.heappop(self._queue)
+                callback()
+                progressed = True
+            waiting = []
+            for ready, callback in self._deferred:
+                if ready():
+                    callback()
+                    progressed = True
+                else:
+                    waiting.append((ready, callback))
+            self._deferred = waiting
+
+    def run(self, programs: Mapping[int, Generator]):
+        if self._ran:
+            raise ValueError("Simulator instances support one run; create a new run for a fresh epoch namespace")
+        self._ran = True
+        self._ranks = {rank: _Rank(program) for rank, program in sorted(programs.items())}
+        try:
+            for step in range(self.max_steps):
+                self._flush()
+                progressed = False
+                for rank, state in self._ranks.items():
+                    if state.done:
+                        continue
+                    if state.blocked is not None:
+                        if not self._wait_ready(rank, state.blocked):
+                            continue
+                        state.blocked, state.result = None, None
+                    try:
+                        op = state.program.send(state.result) if state.started else next(state.program)
+                        state.started, state.result = True, None
+                        self._execute(rank, op)
+                    except StopIteration:
+                        state.done = True
+                        self._trace("rank_end", rank)
+                    progressed = True
+                if all(s.done for s in self._ranks.values()):
+                    pending = [e.id for e in self._events.values() if not self._complete(e)]
+                    leases = [x.id for x in self._leases.values() if not x.ack_acquired]
+                    if pending or leases:
+                        raise ProtocolError(f"run exited without drain/ACK: pending events={pending}, leases={leases}")
+                    self._passed = True
+                    return self.report()
+                if progressed:
+                    self.now += 1
+                elif self._queue:
+                    self.now = max(self.now, self._queue[0][0])
+                else:
+                    blocked = {r: repr(s.blocked) for r, s in self._ranks.items() if not s.done}
+                    raise DeadlockError(f"no future event can advance blocked ranks: {blocked}")
+            raise ProtocolError(f"step budget exhausted ({self.max_steps}); possible livelock")
+        except Exception as error:
+            self._error = f"{type(error).__name__}: {error}"
+            self._trace("failure", -1, error=self._error)
+            raise
+
+    def read_buffer(self, ref):
+        """Return an isolated inspection snapshot; kernel reads use Compute."""
+        return self._buffer(ref).data.copy()
+
+    def report(self):
+        return {
+            "passed": self._passed,
+            "mode": "cpu_rank_protocol_model",
+            "seed": self.seed,
+            "logical_ticks": self.now,
+            "time_unit": "logical_tick_no_physical_unit",
+            "fault": self.fault,
+            "fault_injected": self._fault_used,
+            "error": self._error,
+            "events": len(self._events),
+            "trace_events": len(self.trace_events),
+            "pending_events": [e.id for e in self._events.values() if not self._complete(e)],
+            "open_leases": [x.id for x in self._leases.values() if not x.ack_acquired],
+            "ranks": {str(r): {"done": s.done, "blocked": repr(s.blocked) if s.blocked else None} for r, s in self._ranks.items()},
+        }
