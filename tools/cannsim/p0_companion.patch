+                    sim, seen = exchange(seed=seed, slots=slots, rounds=5, consumer_ticks=7)
+                    self.assertTrue(sim.report()["passed"])
+                    self.assertEqual([len(seen[r]) for r in range(2)], [5, 5])
+                    self.assertEqual(sim.report()["open_leases"], [])
+                    self.assertEqual(sim.report()["pending_events"], [])
