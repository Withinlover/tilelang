+"""The companion stays independent of uncommitted MIX scheduler changes."""
+
+import unittest
+from unittest.mock import patch
+
+from cosim.runtime import prepare_mix_scheduler_fix, record_environment, validate_mix_scheduler_fix
+
+
+class RuntimeCompatibilityTests(unittest.TestCase):
+    def test_off_delegates_original_two_argument_runtime_api(self):
+        fix = prepare_mix_scheduler_fix("cann", "off", 1, {"AIC"})
+        self.assertFalse(fix["apply"])
+        self.assertFalse(fix["mixed"])
+        with patch("cosim.runtime._record_environment", return_value={"fixture": "value"}) as original:
+            self.assertEqual(record_environment("cann", "run", fix), {"fixture": "value"})
+        original.assert_called_once_with("cann", "run")
+        self.assertEqual(validate_mix_scheduler_fix(fix, "run", 1), {"passed": True, "status": "not_applied", "report": None})
+
+    def test_repair_modes_are_rejected(self):
+        for mode in ("auto", "required", "typo", None):
+            with self.subTest(mode=mode), self.assertRaisesRegex(ValueError, "only.*off"):
+                prepare_mix_scheduler_fix("cann", mode, 1, {"AIC"})
+
+    def test_cannot_claim_repair_validation(self):
+        for fix in ({"mode": "off", "apply": True}, {"mode": "auto", "apply": False}, {}, None):
+            with self.subTest(fix=fix), self.assertRaisesRegex(ValueError, "cannot apply or validate"):
+                validate_mix_scheduler_fix(fix, "run", 1)
+            with self.subTest(fix=fix), self.assertRaisesRegex(ValueError, "cannot apply or validate"):
+                record_environment("cann", "run", fix)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_cosim_segments.py b/tests/test_cosim_segments.py
new file mode 100644
index 0000000..2fc9b37
--- /dev/null
+++ b/tests/test_cosim_segments.py
@@ -0,0 +1,246 @@
+"""Exercise segment orchestration with real subprocesses and real trace/accuracy checks."""
+
+import contextlib
+import io
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from cosim.segments import GemmSegmentExecutor, SegmentExecutionError
+from utils.io import sha256
+
+
+# This is a test Host, not a simulator replacement. It executes outside the test
+# process, produces the ordinary binary ABI, and writes minimal real callback
+# records for the production exporter to validate. CANN is not required here.
+FAKE_HOST = r"""
+import argparse
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import time
+import numpy as np
+
+parser = argparse.ArgumentParser()
+for name in ("kernel", "kind", "seq-len", "blocks", "output", "data-dir"):
+    parser.add_argument("--" + name)
+args = parser.parse_args()
+print("test host entered", flush=True)
+arrays = []
+for name in ("a", "b"):
+    raw = np.fromfile(Path(args.data_dir) / (name + ".bin"), dtype="<u2").reshape(64, 64)
+    arrays.append((raw.astype(np.uint32) << 16).view(np.float32))
+result = arrays[0] @ arrays[1]
+if MODE == "wrong-output":
+    result[0, 0] += 1
+result.astype("<f4").tofile(args.output)
+header = struct.Struct("<QQIIIII")
+with open(os.environ["CANNSIM_DETAIL_LOG"], "wb") as stream:
+    stream.write(b"CANNTRC1")
+    for subcore in ([0] if MODE == "missing-end" else [0, 1]):
+        decode = b"(PC: 0x100) FLOWCTRL: (Binary: 0x0) (ID: 1) END"
+        detail = b"test callback detail"
+        for phase in (0, 1):
+            stream.write(header.pack(10 + phase, 0x100, 0, subcore, phase, len(decode), len(detail)))
+            stream.write(decode + detail)
+if MODE == "timeout":
+    # The child must also die: a later marker would expose incomplete group cleanup.
+    marker = str(Path(args.output).parent / "surviving_child")
+    child = "import pathlib,time; time.sleep(1.2); pathlib.Path(%r).write_text('alive')" % marker
+    subprocess.Popen([sys.executable, "-c", child])
+    print("child spawned", flush=True)
+    time.sleep(20)
+if MODE == "failed-exit":
+    sys.exit(7)
+"""
+
+
+class GemmSegmentExecutorTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.kernel = self.root / "test.o"
+        self.kernel.write_bytes(b"verified test fixture ABI")
+        self.source = self.root / "gemm_cannsim_runner"
+        self.mode = "success"
+        self.a = np.full((64, 64), 0x3F80, dtype="<u2")  # BF16 1.0
+        self.b = np.full((64, 64), 0x3F00, dtype="<u2")  # BF16 0.5
+        self.fix_template = {"mode": "off", "apply": False, "verification": {"status": "not_applied"}}
+        self.environment_calls = []
+        self.stack = contextlib.ExitStack()
+        self.addCleanup(self.stack.close)
+        self.build = self.stack.enter_context(patch("cosim.segments.build_runner", side_effect=self.build_host))
+        self.stack.enter_context(patch("cosim.segments.prepare_mix_scheduler_fix", return_value=self.fix_template))
+        self.stack.enter_context(patch("cosim.segments.record_environment", side_effect=self.environment))
+        self.stack.enter_context(contextlib.redirect_stdout(io.StringIO()))
+
+    def build_host(self, cann_home, target):
+        self.source.write_text(f"#!{sys.executable}\nMODE = {self.mode!r}\n" + FAKE_HOST)
+        self.source.chmod(0o755)
+        return self.source
+
+    def environment(self, cann_home, run_dir, mix_fix):
+        # Emulate record_environment's per-launch mutation, preserving os.environ.
+        self.assertNotIn("loaded_library", mix_fix)
+        mix_fix["loaded_library"] = str(run_dir / "runner" / "test-library.so")
+        self.environment_calls.append(mix_fix)
+        result = dict(os.environ)
+        result["CANNSIM_DETAIL_LOG"] = str(run_dir / "instructions.bin")
+        return result
+
+    def executor(self, **kwargs):
+        return GemmSegmentExecutor(self.kernel, self.root / "run", self.root / "cann", **kwargs)
+
+    def test_separate_rank_inputs_and_recordings_build_once(self):
+        initial_environment = dict(os.environ)
+        executor = self.executor()
+        first = executor.execute(0, "local", self.a, self.b)
+        # A later build/ replacement must not alter the per-run Host snapshot.
+        self.source.write_text("this is no longer executable Python\n")
+        second = executor.execute(1, "remote", self.b, self.b)
+        np.testing.assert_array_equal(first, np.full((64, 64), 32, dtype=np.float32))
+        np.testing.assert_array_equal(second, np.full((64, 64), 16, dtype=np.float32))
+        self.assertEqual(self.build.call_count, 1)
+        self.assertEqual(os.environ, initial_environment)
+        self.assertEqual(len(executor.reports), 2)
+        reports = [json.loads(Path(item["manifest_path"]).read_text()) for item in executor.reports]
+        self.assertNotEqual(reports[0]["run_dir"], reports[1]["run_dir"])
+        self.assertNotEqual(reports[0]["input_sha256"]["a"], reports[1]["input_sha256"]["a"])
+        for report in reports:
+            self.assertTrue(report["passed"])
+            self.assertTrue(report["accuracy"]["passed"])
+            self.assertEqual(report["accuracy"]["elements"], 4096)
+            self.assertTrue(report["report_complete"])
+            self.assertTrue(report["mix_scheduler_fix"]["verification"]["passed"])
+            self.assertEqual(len(report["pipeline_traces"]), 2)
+            self.assertTrue(all(Path(path).is_file() for path in report["pipeline_traces"]))
+            self.assertEqual(report["runner_sha256"], sha256(report["runner"]))
+            self.assertEqual(report["input_sha256"]["a"], sha256(Path(report["data_dir"]) / "a.bin"))
+            self.assertEqual(report["record_command"].count("--blocks"), 1)
+        self.assertNotIn("loaded_library", self.fix_template)
+        self.assertNotIn("passed", self.fix_template["verification"])
+        self.assertIsNot(self.environment_calls[0], self.environment_calls[1])
+
+    def test_native_exit_failure_keeps_successful_accuracy_and_trace_but_fails_segment(self):
+        self.mode = "failed-exit"
+        executor = self.executor()
+        with self.assertRaises(SegmentExecutionError) as caught:
+            executor.execute(0, "failed", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertEqual(report["record_returncode"], 7)
+        self.assertTrue(report["accuracy"]["passed"])
+        self.assertTrue(report["report_complete"])
+        self.assertFalse(report["passed"])
+        self.assertIn("test host entered", (Path(report["run_dir"]) / "record.log").read_text())
+        self.assertEqual(executor.reports[0], json.loads(caught.exception.manifest_path.read_text()))
+
+    def test_wrong_output_fails_but_still_exports_both_trace_views(self):
+        self.mode = "wrong-output"
+        with self.assertRaises(SegmentExecutionError) as caught:
+            self.executor().execute(1, "wrong", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertEqual(report["record_returncode"], 0)
+        self.assertEqual(report["accuracy"]["mismatches"], 1)
+        self.assertEqual(report["accuracy"]["max_abs_error"], 1)
+        self.assertTrue(report["report_complete"])
+        self.assertEqual(len(report["pipeline_traces"]), 2)
+
+    def test_missing_vector_end_fails_even_when_accuracy_passes(self):
+        self.mode = "missing-end"
+        with self.assertRaises(SegmentExecutionError) as caught:
+            self.executor().execute(0, "missing_end", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertTrue(report["accuracy"]["passed"])
+        self.assertFalse(report["report_complete"])
+        self.assertIn("missing END", report["report_error"])
+        self.assertEqual(len(report["pipeline_traces"]), 2)
+
+    def test_explicit_pure_cube_requires_only_aic_end(self):
+        self.mode = "missing-end"  # This fixture records an AIC-only kernel.
+        executor = self.executor(expected_cores=("AIC",))
+        executor.execute(0, "pure_cube", self.a, self.b)
+        report = executor.reports[0]
+        self.assertTrue(report["passed"])
+        self.assertEqual(report["expected_cores"], ["AIC"])
+        summary = json.loads(Path(report["pipeline_summary"]).read_text())[0]
+        self.assertEqual(summary["observed_cores"], ["AIC"])
+        self.assertEqual(summary["ended_cores"], ["AIC"])
+        self.assertTrue(summary["complete"])
+        self.assertEqual(len(report["pipeline_traces"]), 2)
+
+    def test_invalid_expected_cores_fail_before_build(self):
+        for cores in ([], ["AIV0"], ["AIC", "unknown"], "AIC"):
+            with self.subTest(cores=cores):
+                with self.assertRaisesRegex(ValueError, "expected_cores"):
+                    self.executor(expected_cores=cores)
+        self.assertEqual(self.build.call_count, 0)
+
+    def test_timeout_kills_child_group_and_preserves_partial_recording(self):
+        self.mode = "timeout"
+        started = time.monotonic()
+        with self.assertRaises(SegmentExecutionError) as caught:
+            self.executor(timeout_seconds=0.8).execute(0, "timeout", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertLess(time.monotonic() - started, 5)
+        self.assertTrue(report["record_timed_out"])
+        self.assertEqual(report["record_returncode"], -9)
+        self.assertFalse(report["passed"])
+        self.assertTrue(report["accuracy"]["passed"])
+        self.assertTrue(report["report_complete"])
+        self.assertIn("child spawned", (Path(report["run_dir"]) / "record.log").read_text())
+        time.sleep(1.3)
+        self.assertFalse((Path(report["run_dir"]) / "surviving_child").exists())
+
+    def test_spawn_failure_is_recorded_and_attempts_accuracy_and_trace(self):
+        executor = self.executor()
+        with patch("cosim.segments.subprocess.Popen", side_effect=OSError("cannot launch fixture")):
+            with self.assertRaises(SegmentExecutionError) as caught:
+                executor.execute(0, "spawn", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertIn("cannot launch fixture", report["errors"][0])
+        self.assertFalse(report["accuracy"]["passed"])
+        self.assertFalse(report["report_complete"])
+        self.assertTrue((Path(report["run_dir"]) / "report.log").is_file())
+
+    def test_missing_required_mix_evidence_fails_despite_correct_computation(self):
+        self.fix_template["apply"] = True
+        self.fix_template["verification"] = {"status": "pending"}
+        with self.assertRaises(SegmentExecutionError) as caught:
+            self.executor().execute(0, "no_mix_report", self.a, self.b)
+        report = caught.exception.manifest
+        self.assertTrue(report["accuracy"]["passed"])
+        self.assertTrue(report["report_complete"])
+        self.assertFalse(report["mix_scheduler_fix"]["verification"]["passed"])
+        self.assertFalse(report["passed"])
+
+    def test_changed_kernel_is_rejected_before_launch_and_reported(self):
+        executor = self.executor()
+        self.kernel.write_bytes(b"a different ABI")
+        with self.assertRaises(SegmentExecutionError) as caught:
+            executor.execute(0, "changed", self.a, self.b)
+        self.assertIn("kernel object changed", caught.exception.manifest["errors"][0])
+        self.assertEqual(self.environment_calls, [])
+
+    def test_rejects_float_arrays_and_invalid_limits(self):
+        executor = self.executor()
+        with self.assertRaisesRegex(ValueError, "raw little-endian BF16"):
+            executor.execute(0, "float", self.a.astype(np.float32), self.b)
+        for timeout in (0, -1, float("inf"), float("nan")):
+            with self.assertRaisesRegex(ValueError, "timeout"):
+                self.executor(timeout_seconds=timeout)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_cosim_worker.py b/tests/test_cosim_worker.py
new file mode 100644
index 0000000..5cd0e1a
--- /dev/null
+++ b/tests/test_cosim_worker.py
@@ -0,0 +1,195 @@
+"""The JSON bridge must isolate native stdout and reject malformed requests."""
+
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Exercise the actual CLI worker and OS file descriptors in a fresh process.
+# The fixture emits native stdout during build and execution to reproduce the
+# contamination that contextlib.redirect_stdout alone cannot prevent.
+WORKER_FIXTURE = r"""
+import os
+import subprocess
+import sys
+from cosim import worker
+
+class Executor:
+    def __init__(self, *args, **kwargs):
+        print("python build diagnostic", flush=True)
+        subprocess.run([sys.executable, "-c", "import os; os.write(1, b'native build diagnostic\\n')"], check=True)
+        if os.environ.get("WORKER_TEST_STARTUP_FAIL"):
+            raise RuntimeError("fixture initialization failed")
+        self.reports = []
+    def execute(self, rank, segment_id, a, b):
+        os.write(1, b"native execute diagnostic\n")
+        self.reports.append({"passed": True, "rank": rank, "segment_id": segment_id,
+                             "first_a": int(a[0, 0]), "first_b": int(b[0, 0])})
+worker.prepare_environment = lambda: "/unused-fixture-cann"
+worker.GemmSegmentExecutor = Executor
+raise SystemExit(worker.main())
+"""
+
+
+CANCELLABLE_WORKER_FIXTURE = r"""
+import os
+from pathlib import Path
+from cosim import worker
+from cosim import segments
+segments.build_runner = lambda *args: Path(os.environ["WORKER_TEST_HOST"])
+segments.prepare_mix_scheduler_fix = lambda *args: {"mode":"off", "apply":False}
+segments.record_environment = lambda *args: dict(os.environ)
+worker.prepare_environment = lambda: "/unused-fixture-cann"
+raise SystemExit(worker.main())
+"""
+
+CANCELLABLE_HOST = r"""
+import argparse, json, os, subprocess, sys, time
+from pathlib import Path
+parser = argparse.ArgumentParser()
+for name in ("kernel", "kind", "seq-len", "blocks", "output", "data-dir"):
+    parser.add_argument("--" + name)
+args = parser.parse_args()
+directory = Path(args.output).parent
+marker = str(directory / "orphan_survived")
+child = subprocess.Popen([sys.executable, "-c", "import pathlib,time; time.sleep(1.2); pathlib.Path(%r).write_text('alive')" % marker])
+(directory / "spawned.json").write_text(json.dumps({"runner":os.getpid(), "child":child.pid}))
+time.sleep(30)
+"""
+
+
+class WorkerTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.directory = Path(self.temporary.name)
+        for name, value in (("a", 0x3F80), ("b", 0x3F00)):
+            np.full((64, 64), value, dtype="<u2").tofile(self.directory / f"{name}.bin")
+
+    def run_worker(self, requests, *, fail_startup=False):
+        environment = dict(os.environ)
+        if fail_startup:
+            environment["WORKER_TEST_STARTUP_FAIL"] = "1"
+        process = subprocess.run(
+            [
+                sys.executable,
+                "-c",
+                WORKER_FIXTURE,
+                "--kernel",
+                str(self.directory / "test.aibin"),
+                "--run-dir",
+                str(self.directory),
+                "--expected-cores",
+                "AIC",
+            ],
+            input="".join(json.dumps(request) + "\n" for request in requests),
+            cwd=ROOT,
+            env=environment,
+            capture_output=True,
+            text=True,
+            timeout=10,
+        )
+        return process, [json.loads(line) for line in process.stdout.splitlines()]
+
+    def test_native_and_python_diagnostics_do_not_contaminate_json_wire(self):
+        request = dict(op="execute", rank=1, segment_id="received", a=str(self.directory / "a.bin"), b=str(self.directory / "b.bin"))
+        process, responses = self.run_worker([request, {"op": "close"}])
+        self.assertEqual(process.returncode, 0, process.stderr)
+        self.assertEqual(len(responses), 2)
+        self.assertEqual(responses[0], {"ready": True})
+        self.assertTrue(responses[1]["passed"])
+        self.assertEqual(responses[1]["manifest"]["first_a"], 0x3F80)
+        self.assertEqual(responses[1]["manifest"]["first_b"], 0x3F00)
+        for diagnostic in ("python build diagnostic", "native build diagnostic", "native execute diagnostic"):
+            self.assertIn(diagnostic, process.stderr)
+            self.assertNotIn(diagnostic, process.stdout)
+
+    def test_request_errors_are_json_failures_and_worker_remains_usable(self):
+        process, responses = self.run_worker([[], {"op": "unknown"}, {"op": "close"}])
+        self.assertEqual(process.returncode, 0)
+        self.assertTrue(responses[0]["ready"])
+        self.assertFalse(responses[1]["passed"])
+        self.assertIn("JSON object", responses[1]["error"])
+        self.assertFalse(responses[2]["passed"])
+        self.assertIn("execute or close", responses[2]["error"])
+
+    def test_sigterm_worker_kills_active_native_group_and_records_failure(self):
+        kernel = self.directory / "test.aibin"
+        kernel.write_bytes(b"fixture ABI")
+        host = self.directory / "gemm_cannsim_runner"
+        host.write_text(f"#!{sys.executable}\n" + CANCELLABLE_HOST)
+        host.chmod(0o755)
+        environment = dict(os.environ, WORKER_TEST_HOST=str(host))
+        process = subprocess.Popen(
+            [
+                sys.executable,
+                "-c",
+                CANCELLABLE_WORKER_FIXTURE,
+                "--kernel",
+                str(kernel),
+                "--run-dir",
+                str(self.directory / "run"),
+                "--expected-cores",
+                "AIC",
+                "--timeout",
+                "20",
+            ],
+            cwd=ROOT,
+            env=environment,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+        spawned = []
+        try:
+            self.assertEqual(json.loads(process.stdout.readline()), {"ready": True})
+            request = dict(op="execute", rank=0, segment_id="cancel", a=str(self.directory / "a.bin"), b=str(self.directory / "b.bin"))
+            process.stdin.write(json.dumps(request) + "\n")
+            process.stdin.flush()
+            deadline = time.monotonic() + 5
+            while not spawned and time.monotonic() < deadline:
+                spawned = list(self.directory.glob("run/segments/*/spawned.json"))
+                time.sleep(0.02)
+            self.assertEqual(len(spawned), 1, "fixture Host did not start")
+            process.terminate()
+            self.assertEqual(process.wait(timeout=5), 128 + signal.SIGTERM)
+            report = json.loads((spawned[0].parent / "manifest.json").read_text())
+            self.assertFalse(report["passed"])
+            self.assertTrue(report["record_interrupted"])
+            self.assertEqual(report["record_returncode"], -signal.SIGKILL)
+            self.assertIn("SystemExit", report["errors"][0])
+            time.sleep(1.3)
+            self.assertFalse((spawned[0].parent / "orphan_survived").exists())
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.wait(timeout=5)
+            for path in spawned:
+                try:
+                    os.killpg(json.loads(path.read_text())["runner"], signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+            for stream in (process.stdin, process.stdout, process.stderr):
+                stream.close()
+
+    def test_initialization_failure_returns_one_json_response_and_nonzero_exit(self):
+        process, responses = self.run_worker([], fail_startup=True)
+        self.assertEqual(process.returncode, 1)
+        self.assertEqual(len(responses), 1)
+        self.assertFalse(responses[0]["ready"])
+        self.assertIn("fixture initialization failed", responses[0]["error"])
+
+
+if __name__ == "__main__":
+    unittest.main()
